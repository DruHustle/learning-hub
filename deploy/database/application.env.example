# Connection reference only; review through the existing private runtime mechanism.
# Preserve the current primary until a copy, restore and application rehearsal pass.
# Keep the existing SESSION_SECRET and ALLOWED_ORIGINS unchanged.
# Use a reviewed non-superuser role with the application's startup DDL permissions.
# Percent-encode username/password/database URL components as required.
# For the Docker candidate, the certificate hostname is learning-hub-postgres.
# External PostgreSQL remains supported using its verified provider hostname/CA.
DATABASE_URL=postgresql://<reviewed-app-role>:<url-encoded-password>@<current-or-qualified-database-host>:5432/<existing-database-name>?sslmode=verify-full&sslrootcert=/run/learning-hub-db-ca/root.crt
