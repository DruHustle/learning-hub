# Optional isolated database candidate. This does not select an application primary.
LEARNING_HUB_POSTGRES_IMAGE=postgres:<source-compatible-version>@sha256:<reviewed-image-digest>
LEARNING_HUB_POSTGRES_PLATFORM=<qualified-linux-platform>
LEARNING_HUB_POSTGRES_UID=<postgres-uid-from-reviewed-image>
LEARNING_HUB_POSTGRES_GID=<postgres-gid-from-reviewed-image>
LEARNING_HUB_POSTGRES_MEMORY_LIMIT=<capacity-qualified-memory-limit>
LEARNING_HUB_POSTGRES_CPU_LIMIT=<capacity-qualified-cpu-limit>
LEARNING_HUB_POSTGRES_SHM_SIZE=<capacity-qualified-shared-memory-limit>
LEARNING_HUB_POSTGRES_MAX_CONNECTIONS=<capacity-qualified-connection-limit>
LEARNING_HUB_POSTGRES_VOLUME=<existing-reviewed-durable-volume-name>
LEARNING_HUB_POSTGRES_PASSWORD_FILE=<absolute-private-bootstrap-password-file>
LEARNING_HUB_POSTGRES_TLS_DIR=<absolute-private-directory-with-server.crt-server.key>
LEARNING_HUB_DATABASE_CA_FILE=<absolute-readable-public-CA-file-for-selected-database>
