# Browser API origin; omit for the local-only demo experience.
VITE_API_URL=http://localhost:3001
# Server configuration. Set these directly in the hosting provider in production.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/learning_hub
# For external production connections, use the provider TLS settings (sslmode=verify-full).
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000
